# Copy to .env and adjust. Every value here is a placeholder; never commit a real .env.

# HTTP server
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database. Leave DATABASE_URL unset to use an embedded PGlite database (no setup needed).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/issue_triage
# Where PGlite stores its files, relative to apps/api. Use memory:// for a throwaway database.
PGLITE_DATA_DIR=.data/pglite
