# Copy to .env and adjust. Every value here is a placeholder; never commit a real .env.

# HTTP server. The review API has no authentication yet: keep it on 127.0.0.1.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database. Leave DATABASE_URL unset to use an embedded PGlite database (no setup needed).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/issue_triage
# Where PGlite stores its files, relative to apps/api. Use memory:// for a throwaway database.
PGLITE_DATA_DIR=.data/pglite

# GitHub webhook. Must match the secret set on the webhook in GitHub (at least 16 characters).
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# GitHub API token. Triage reads each repository's labels; write-back reads and changes issue
# labels. Minimum fine-grained permissions, on the repositories you triage: Issues read and write,
# plus Metadata read (always included). Read-only (Issues read) is enough with
# WRITE_BACK_MODE=dry-run, and public repositories can be read without a token at a low rate limit.
# GITHUB_TOKEN=github_pat_replace-me

# Write-back of reviewed labels: github (the default) | dry-run, which records the change it would
# make without calling GitHub. `npm run dev` uses dry-run unless this is set.
# WRITE_BACK_MODE=github
# How long a review waits before it is written to GitHub; Undo works until then.
WRITE_BACK_DELAY_MS=10000
# Which label each priority writes (JSON). Unmapped priorities are kept in this app only.
# PRIORITY_LABELS={"urgent":"priority: urgent","high":"priority: high"}

# Triage engine: anthropic | bedrock | fake. `fake` needs no credentials and is refused when
# NODE_ENV=production.
TRIAGE_PROVIDER=fake
# Model id. Defaults to claude-opus-5-5 (anthropic) or anthropic.claude-opus-5-5 (bedrock).
# TRIAGE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TRIAGE_EFFORT=medium
# Per request to the model. A job's overall deadline is three times this.
TRIAGE_MODEL_TIMEOUT_MS=60000
# Jobs run at once by this process. 0 disables the worker here (it must run here with PGlite).
TRIAGE_WORKER_CONCURRENCY=1
TRIAGE_MAX_ATTEMPTS=5

# Provider credentials are read by the SDKs straight from the environment.
# Anthropic API:
# ANTHROPIC_API_KEY=sk-ant-replace-me
# Amazon Bedrock: a region, plus credentials from the standard AWS chain (AWS_PROFILE, access
# keys, or an instance role).
# AWS_REGION=us-east-1
