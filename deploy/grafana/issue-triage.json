{
  "title": "issue-triage",
  "uid": "issue-triage",
  "description": "Triage jobs, the queue, model calls and their cost, reviews, write-backs, and webhooks of the issue-triage API and worker. Import it and pick a Prometheus data source that scrapes both processes' /metrics.",
  "tags": ["issue-triage", "genai", "opentelemetry"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "issue-triage",
      "type": "link",
      "url": "https://github.com/nicogranuja/issue-triage#observability",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "price_input",
        "label": "Input",
        "type": "textbox",
        "query": "4",
        "current": {
          "text": "4",
          "value": "4"
        },
        "hide": 0,
        "description": "USD per million input tokens, for the cost estimate"
      },
      {
        "name": "price_output",
        "label": "Output",
        "type": "textbox",
        "query": "20",
        "current": {
          "text": "20",
          "value": "20"
        },
        "hide": 0,
        "description": "USD per million output tokens, for the cost estimate"
      },
      {
        "name": "price_cache_read",
        "label": "Cache read",
        "type": "textbox",
        "query": "0.2",
        "current": {
          "text": "0.2",
          "value": "0.2"
        },
        "hide": 0,
        "description": "USD per million cache read tokens, for the cost estimate"
      },
      {
        "name": "price_cache_write",
        "label": "Cache write",
        "type": "textbox",
        "query": "5",
        "current": {
          "text": "5",
          "value": "5"
        },
        "hide": 0,
        "description": "USD per million cache write tokens, for the cost estimate"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Triage throughput",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Triage job runs by outcome",
      "description": "Triage job runs (attempts) per second, by how they ended. retrying and failed runs are broken down under failures.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(issue_triage_job_runs_total{kind=\"triage\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job duration (p50, p95)",
      "description": "Time from claiming a job to the end of its run, by kind. A triage run includes the model call.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(issue_triage_job_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{kind}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(issue_triage_job_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{kind}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job failures by error class",
      "description": "Failed job runs per second, by kind, error class (an allowlist; anything else is other), and whether the job will be retried.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (kind, error_type, retryable) (rate(issue_triage_job_failures_total[$__rate_interval]))",
          "legendFormat": "{{kind}} {{error_type}} retryable={{retryable}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Queue depth and age",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Jobs in the queue by kind and state: due now, waiting out a delay or backoff, or running. Reported at 0 when empty. The API and every worker report the same database-wide count, so this takes the largest rather than the sum.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (kind, state) (issue_triage_queue_depth)",
          "legendFormat": "{{kind}} {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Oldest due job age",
      "description": "How long the oldest due job has waited to be claimed, by kind. Growing steadily means the workers are not keeping up. Every process reports the same database-wide value, so this takes the largest.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (kind) (issue_triage_queue_oldest_age)",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Model latency, tokens, and cost",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Model latency (p50, p95)",
      "description": "Time to get a suggestion, a corrective turn included, by configured model (gen_ai.client.operation.duration).",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{gen_ai_request_model}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{gen_ai_request_model}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens by type",
      "description": "Tokens billed per second for suggestions. input is the uncached remainder; cache_read and cache_write are counted apart, so the four add up without overlap.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(issue_triage_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Estimated cost (USD per hour)",
      "description": "Tokens times the per-million-token prices in the dashboard variables (default: Claude Opus 5.5 list prices; check https://platform.claude.com/docs/en/about-claude/pricing). An estimate: tokens are labeled with the configured model, so a refusal fallback is priced at that model's rates, and Bedrock is billed by AWS.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(((sum(rate(issue_triage_model_tokens_total{type=\"input\"}[$__rate_interval])) or vector(0)) * $price_input + (sum(rate(issue_triage_model_tokens_total{type=\"output\"}[$__rate_interval])) or vector(0)) * $price_output + (sum(rate(issue_triage_model_tokens_total{type=\"cache_read\"}[$__rate_interval])) or vector(0)) * $price_cache_read + (sum(rate(issue_triage_model_tokens_total{type=\"cache_write\"}[$__rate_interval])) or vector(0)) * $price_cache_write) * 3600 / 1e6)",
          "legendFormat": "USD/h",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Estimated cost (time range)",
      "description": "The same estimate, summed over the selected time range.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(((sum(increase(issue_triage_model_tokens_total{type=\"input\"}[$__range])) or vector(0)) * $price_input + (sum(increase(issue_triage_model_tokens_total{type=\"output\"}[$__range])) or vector(0)) * $price_output + (sum(increase(issue_triage_model_tokens_total{type=\"cache_read\"}[$__range])) or vector(0)) * $price_cache_read + (sum(increase(issue_triage_model_tokens_total{type=\"cache_write\"}[$__range])) or vector(0)) * $price_cache_write) / 1e6)",
          "legendFormat": "USD",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "row",
      "title": "Validation retries and refusals",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Suggestions by outcome",
      "description": "Requests for a suggestion: valid on the first try, valid after a corrective turn, invalid twice, refused by the model, or failed (timeouts, API errors).",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(issue_triage_model_suggestions_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Validation retry rate",
      "description": "Share of suggestion requests that needed a corrective turn because the output failed validation.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(issue_triage_model_validation_retries_total[$__rate_interval])) / sum(rate(issue_triage_model_suggestions_total[$__rate_interval]))",
          "legendFormat": "validation retries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refusal and fallback rates",
      "description": "Share of suggestion requests the model refused, and share answered by the server-side refusal fallback model.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(issue_triage_model_suggestions_total{outcome=\"refused\"}[$__rate_interval])) / sum(rate(issue_triage_model_suggestions_total[$__rate_interval]))",
          "legendFormat": "refused",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "range": true
        },
        {
          "expr": "sum(rate(issue_triage_model_fallbacks_total[$__rate_interval])) / sum(rate(issue_triage_model_suggestions_total[$__rate_interval]))",
          "legendFormat": "answered by fallback",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Review decisions",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Reviews by decision",
      "description": "Reviews submitted per second: accepted as suggested, edited, or rejected.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
